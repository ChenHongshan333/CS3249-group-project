# Copy this file to server/.env and fill in what you have.
# .env is ignored by git. Never commit a real key.

# Which model answers: claude, openai, qwen, or fake (no key, canned replies).
LLM_PROVIDER=claude

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# OpenAI (platform.openai.com). Pick a current vision-capable model from
# OpenAI's model list; there is no default because names change often.
OPENAI_API_KEY=
OPENAI_MODEL=

# Qwen through Alibaba Cloud Model Studio (international / Singapore region).
# Check the console for current vision model names.
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# The app waits 6 s for /ask and 8 s for /check-step.
ASK_TIMEOUT_S=5
CHECK_TIMEOUT_S=7

# Optional. When set, the app must send this in an X-API-Key header.
# Needs the app change described in server/README.md before you turn it on.
APP_API_KEY=

# Optional. Turns on GET /export/events.csv (send it as X-Admin-Key).
ADMIN_KEY=

LOG_DB_PATH=data/cookalong.db
